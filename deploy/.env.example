# Copy to /opt/wego/.env on the server and fill in. Never commit the real file.

# Domain whose DNS A record points to the server, e.g. wego.prolan.de
WEGO_DOMAIN=

# Database password, e.g. from: openssl rand -base64 32
POSTGRES_PASSWORD=

# First planner account. Only used while no account exists; remove both lines after the first sign-in.
SEED_PLANER_USERNAME=planer
SEED_PLANER_PASSWORD=

# Set by the GitHub workflow "Deploy" to the commit that is running.
WEGO_TAG=latest
